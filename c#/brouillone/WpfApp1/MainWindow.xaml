<Window 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Win32="clr-namespace:Microsoft.Win32;assembly=Microsoft.Win32.SystemEvents"
    x:Class="MainWindow.MainWindow"
    Title="Voyage Planner" Height="700" Width="1000">

    <Grid>
        <TabControl>
            <TabControl.Background>
                <ImageBrush ImageSource="C:\Users\pro\Downloads\vecteezy_aircraft-wing-and-clouds-at-sunset_1963903.jpg"/>
            </TabControl.Background>

            <!-- Connexion utilisateur -->
            <TabItem Header="Connexion (utilisateur)">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="#FFAF2828" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="250" Width="317" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True" AllowDrop="True" Focusable="True">
                    <StackPanel.Background>
                        <SolidColorBrush Color="White" Opacity="0.2"/>
                    </StackPanel.Background>
                    <StackPanel.Effect>
                        <DropShadowEffect/>
                    </StackPanel.Effect>
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="0"/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <Label Content="Nom d'utilisateur :" HorizontalAlignment="Center"/>
                    <TextBox Width="300" Margin="0,5,0,5" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Label Content="Mot de passe :" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <PasswordBox Width="300" Margin="0,5,0,5" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Button Content="Se connecter" Width="150" Margin="5" Background="#FF8A2A" Foreground="White" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                </StackPanel>
            </TabItem>

            <!-- Inscription utilisateur -->
            <TabItem Header="Inscription (utilisateur)">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="#FFAF2828" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="356" Width="318" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}">
                    <StackPanel.Effect>
                        <DropShadowEffect/>
                    </StackPanel.Effect>
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="0"/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <Label Content="Nom d'utilisateur :"/>
                    <TextBox Width="300" Margin="0,5,0,5" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Label Content="Mot de passe :"/>
                    <PasswordBox Width="300" Margin="0,5,0,5" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Label Content="Confirmer mot de passe :"/>
                    <PasswordBox Width="300" Margin="0,5,0,5" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Label Content="Images"/>
                    <Button Content="Choisir une image" Width="150" Margin="5" Background="#FF8A2A" Foreground="White" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Button Content="S'inscrire" Width="150" Margin="5" Background="#FF8A2A" Foreground="White" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                </StackPanel>
            </TabItem>

            <!-- Gestion des Utilisateurs -->
            <TabItem Header="Gestion Util (admin)">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="#FFAF2828" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="250" Width="317" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}">
                    <StackPanel.Effect>
                        <DropShadowEffect/>
                    </StackPanel.Effect>
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="0"/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <Button Content="Ajouter Utilisateur" Width="200" Margin="5" Background="#FF8A2A" Foreground="White" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Button Content="Modifier Utilisateur" Width="200" Margin="5" Background="#FF8A2A" Foreground="White" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Button Content="Supprimer Utilisateur" Width="200" Margin="5" Background="#FF8A2A" Foreground="White" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                </StackPanel>
            </TabItem>

            <!-- Gestion des Voyages -->
            <TabItem Header="Voyages">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="#FFAF2828" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="459" Width="318" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}">
                    <StackPanel.Effect>
                        <DropShadowEffect/>
                    </StackPanel.Effect>
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="0"/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <Label Content="Liste des voyages " HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36"/>
                    <ListBox Margin="10" Height="200"/>
                    <Button Content="Ajouter Voyage" Width="200" Margin="5" Background="#FF8A2A" Foreground="White" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Button Content="Modifier Voyage" Width="200" Margin="5" Background="#FF8A2A" Foreground="White" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Button Content="Supprimer Voyage" Width="200" Margin="5" Background="#FF8A2A" Foreground="White" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                </StackPanel>
            </TabItem>

            <!-- Panier et Commandes -->
            <TabItem Header="Panier">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="#FFAF2828" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="250" Width="317" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}">
                    <StackPanel.Effect>
                        <DropShadowEffect/>
                    </StackPanel.Effect>
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="0"/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <Label Content="Budget Min :"/>
                    <TextBox Width="200" Margin="5" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Label Content="Budget Max :"/>
                    <TextBox Width="200" Margin="5" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Button Content="Filtrer" Width="100" Margin="5" Background="#FF8A2A" Foreground="White" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <ListBox Margin="10" Height="200"/>
                    <Button Content="Ajouter au Panier" Width="200" Margin="5" Background="#FF8A2A" Foreground="White" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Button Content="Supprimer du Panier" Width="200" Margin="5" Background="#FF8A2A" Foreground="White" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                    <Button Content="Payer" Width="200" Margin="5" Background="#FF8A2A" Foreground="White" BorderBrush="#FF8A2A" BorderThickness="1" Padding="10"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
