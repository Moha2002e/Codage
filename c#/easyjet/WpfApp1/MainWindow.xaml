<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Voyages" 
        WindowState="Maximized" 
        Background="White">
    <Grid>
        <DockPanel LastChildFill="True">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Background="#FF6600" Height="60" DockPanel.Dock="Top">
                <Label Content="VoyagesApp" FontSize="24" Foreground="White" Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="Bold" />
                <Button Content="Se connecter" Foreground="White" Background="#FF6600" BorderThickness="0" FontSize="16"  VerticalAlignment="Center" HorizontalAlignment="Right" Click="SeConnecter_Click"/>
                <Button Content="S'inscrire" Foreground="White" Background="#FF6600" BorderThickness="0" FontSize="16"  VerticalAlignment="Center" HorizontalAlignment="Right" Click="Inscrire_Click"/>
            </StackPanel>

            <!-- Search Section -->
            <StackPanel Orientation="Horizontal" Height="100" Background="#FFF5E6" DockPanel.Dock="Top" Margin="0,0,0,10" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBox Width="200" Margin="20,20,10,20" VerticalAlignment="Center" />
                <TextBox Width="200" Margin="0,20,10,20" VerticalAlignment="Center" />
                <DatePicker Width="200" Margin="0,20,10,20" VerticalAlignment="Center"/>
                <ComboBox Width="150" Margin="0,20,10,20" VerticalAlignment="Center">
                    <ComboBoxItem Content="1 Adulte" IsSelected="True"/>
                    <ComboBoxItem Content="2 Adultes"/>
                    <ComboBoxItem Content="Famille"/>
                </ComboBox>
                <Button Content="Rechercher" Background="#FF6600" Foreground="White" Width="150" Margin="0,20,20,20" FontSize="16"/>
            </StackPanel>

            <!-- Main Content -->
            <Grid>
                <!-- Contenu principal ici -->
            </Grid>
        </DockPanel>
    </Grid>
</Window>
