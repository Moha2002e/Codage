<Window x:Class="WpfApp1.InscrireWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Voyages"
        WindowState="Maximized"
        Background="White">
  <Grid>
    <DockPanel LastChildFill="True">
      <!-- Header -->
      <StackPanel Orientation="Horizontal" Background="#FF6600" Height="60" DockPanel.Dock="Top">
        <Label Content="VoyagesApp" FontSize="24" Foreground="White" Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="Bold" />
        <Button Content="Accueil" Foreground="White" Background="#FF6600" BorderThickness="0" FontSize="16"  VerticalAlignment="Center" HorizontalAlignment="Right" Click="Main_Click"/>
      </StackPanel>

      <!-- Main Content -->
      <Grid>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Height="300" Padding="20">
          <StackPanel>
            <TextBlock Text="Connexion" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <Label Content="Email" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox Width="350" Margin="0,10,0,10" />
            <Label Content="Mot de passe" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <PasswordBox Width="350" Margin="0,10,0,20"/>
            <Button Content="Se connecter" Background="#FF6600" Foreground="White" Width="350" Height="40"/>
          </StackPanel>
        </Border>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
