<Window x:Class="WpfApp1.MainConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Voyages" 
        WindowState="Maximized" 
        Background="White">
    <Grid>
        <DockPanel LastChildFill="True">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Background="#FF6600" Height="60" DockPanel.Dock="Top">
                <Label Content="VoyagesApp" FontSize="24" Foreground="White" Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="Bold" />
                <Button Content="Admin" Background="White" Foreground="#FF6600" Margin="20,0,0,0" VerticalAlignment="Center" Click="AdminButton_Click"/>
            </StackPanel>

            <!-- Search Section -->
            <StackPanel Orientation="Horizontal" Height="100" Background="#FFF5E6" DockPanel.Dock="Top" Margin="0,0,0,10" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBox Width="200" Margin="20,20,10,20" VerticalAlignment="Center"/>
                <TextBox Width="200" Margin="0,20,10,20" VerticalAlignment="Center" />
                <DatePicker Width="200" Margin="0,20,10,20" VerticalAlignment="Center"/>
                <ComboBox Width="150" Margin="0,20,10,20" VerticalAlignment="Center">
                    <ComboBoxItem Content="1 Adulte" IsSelected="True"/>
                    <ComboBoxItem Content="2 Adultes"/>
                    <ComboBoxItem Content="Famille"/>
                </ComboBox>
                <Button Content="Rechercher" Background="#FF6600" Foreground="White" Width="150" Margin="0,20,20,20" FontSize="16" Click="SearchButton_Click"/>
            </StackPanel>

            <!-- Main Content -->
            <Grid>
                <DataGrid Name="VoyagesDataGrid" Margin="20" AutoGenerateColumns="True"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20">
                    <Button Content="Ajouter au Panier" Background="#FF6600" Foreground="White" Margin="5" Click="AddToCart_Click"/>
                    <Button Content="Voir Panier" Background="#FF6600" Foreground="White" Margin="5" Click="ViewCart_Click"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>