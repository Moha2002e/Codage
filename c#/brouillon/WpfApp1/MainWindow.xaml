<Window x:Class="VoyagePlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voyage Planner" Height="600" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450*"/>
            <ColumnDefinition Width="217*"/>
        </Grid.ColumnDefinitions>
        <TabControl>
            <TabItem Header="Connexion">
                <StackPanel Margin="20">
                    <Label Content="Nom d'utilisateur:"/>
                    <TextBox x:Name="UsernameTextBox"/>
                    <Label Content="Mot de passe:"/>
                    <PasswordBox x:Name="PasswordBox"/>
                    <Button Content="Se connecter" Click="Login_Click" Margin="5"/>
                    <Button Content="Créer un utilisateur" Click="CreateUser_Click" Margin="5"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Voyages">
                <StackPanel Margin="20">
                    <Button Content="Ajouter un voyage" Click="AddVoyage_Click" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibility}}"/>
                    <DataGrid x:Name="VoyagesDataGrid" AutoGenerateColumns="True" Height="400"/>
                    <Button Content="Ajouter au panier" Click="AddToCart_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Panier">
                <StackPanel Margin="20">
                    <DataGrid x:Name="CartDataGrid" AutoGenerateColumns="True" Height="300"/>
                    <Button Content="Supprimer du panier" Click="RemoveFromCart_Click" Margin="5"/>
                    <Button Content="Procéder au paiement" Click="Checkout_Click" Margin="5"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
